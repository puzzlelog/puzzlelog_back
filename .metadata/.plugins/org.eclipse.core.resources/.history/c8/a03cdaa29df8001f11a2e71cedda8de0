package com.puzzlelog.puzzlelog.service;

import java.time.LocalDateTime;
import java.util.ArrayList;
import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import com.puzzlelog.puzzlelog.document.Notification;
import com.puzzlelog.puzzlelog.entity.User;
import com.puzzlelog.puzzlelog.repository.NotificationRepository;
import com.puzzlelog.puzzlelog.repository.UserRepository;

import lombok.RequiredArgsConstructor;

@Service
@RequiredArgsConstructor
public class NotificationService {

	@Autowired
    private NotificationRepository notificationRepository;
	
	@Autowired
    private UserRepository userRepository;

    //알람 저장
    public Notification saveNotification(Notification notification) {
        return notificationRepository.save(notification);
    }

    //알람 발송 (시간 지난, 발송되지 않은 것만)
    public List<String> sendNotifications() {
        List<Notification> notifications = notificationRepository.findBySentFalseAndSendTimeBefore(LocalDateTime.now());
        List<User> users = userRepository.findByAlarmConsentTrue();
        
        System.out.println("MySQL에서 가져온 사용자 목록: " + users.size());
        

        List<String> sentMessages = new ArrayList<>();
        for (Notification notification : notifications) {
            for (User user : users) {
            	
            	System.out.println("사용자 확인: " + user.getUserId());
            	
            	
                String logMessage = "사용자: " + user.getUserId() + " → 알람 내용: " + notification.getMessage();
                System.out.println(logMessage);
                sentMessages.add(logMessage);
            }
            notification.setSent(true);
            notificationRepository.save(notification);
        }
        return sentMessages;
    }
}

