package com.puzzlelog.api.controller.old;

import java.time.Instant;
import java.util.List;
import java.util.Optional;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PatchMapping;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.bind.annotation.RestController;

import com.puzzlelog.puzzlelog.document.TimeCapsuleDocument;
import com.puzzlelog.puzzlelog.repository.TimeCapsuleRepository;

@RestController
@RequestMapping("/api")
public class TimeCapsuleController {

	@Autowired
	private TimeCapsuleRepository timeCapsuleRepository;
	
	// 타임캡슐 저장
	@PostMapping("/addTimeCapsule")
	public ResponseEntity<String> addTimeCapsule(@RequestBody TimeCapsuleDocument capsule) {
		if (capsule == null) {
			return ResponseEntity.badRequest().body("Invalid time capsule data");
		}
		try {
			capsule.setCreatedAt(Instant.now());
			timeCapsuleRepository.save(capsule);
			return ResponseEntity.status(HttpStatus.CREATED).body("Time capsule saved successfully");
		} catch (Exception e) {
			e.printStackTrace();
			return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR).body("Error saving time capsule");
		}
	}
	
	// 타임캡슐 불러오기
	@GetMapping("/getTimeCapsule")
	public ResponseEntity<List<TimeCapsuleDocument>> getTimeCapsule(@RequestParam(required = false) String userId) {
		try {
			List<TimeCapsuleDocument> capsules;
			
			if (userId != null) {
				capsules = timeCapsuleRepository.findByUserId(userId);
			} else {
				capsules = timeCapsuleRepository.findAllActive();
			}
			
			if (capsules.isEmpty()) {
				return ResponseEntity.status(HttpStatus.NOT_FOUND).body(capsules);
			}
			return ResponseEntity.ok(capsules);
		} catch (Exception e) {
			return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR).body(null);
		}
	}
	
	// 타임캡슐 삭제 (isDeleted를 true로 설정)
	@PatchMapping("/deleteTimeCapsule")
	public ResponseEntity<String> deleteTimeCapsule(@RequestParam String id) {
	    try {
	        Optional<TimeCapsuleDocument> existingCapsuleOptional = timeCapsuleRepository.findById(id);
	        if (existingCapsuleOptional.isEmpty()) {
	            return ResponseEntity.status(HttpStatus.NOT_FOUND).body("Time capsule not found");
	        }

	        TimeCapsuleDocument existingCapsule = existingCapsuleOptional.get();
	        
	        // isDeleted를 true로 설정하여 논리적 삭제
	        existingCapsule.setDeleted(true);
	        
	        timeCapsuleRepository.save(existingCapsule);
	        return ResponseEntity.ok("Time capsule deleted successfully");
	    } catch (Exception e) {
	        return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR).body("Error deleting time capsule");
	    }
	}
}
