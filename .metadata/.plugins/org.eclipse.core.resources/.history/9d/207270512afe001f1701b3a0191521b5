package com.puzzlelog.api.controller.old;

import java.time.Instant;
import java.util.List;
import java.util.Optional;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PatchMapping;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.PutMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.bind.annotation.RestController;

import com.puzzlelog.api.document.old.DiaryDocument;
import com.puzzlelog.api.repository.old.DiaryRepository;

@RestController("oldDiaryController")
@RequestMapping("/api")
public class DiaryController {

	@Autowired
	private DiaryRepository diaryRepository;
	
	// 일기 저장
	@PostMapping("/addDiary")
	public ResponseEntity<String> addDiary(@RequestBody DiaryDocument diary) {
		if (diary == null) {
			return ResponseEntity.badRequest().body("Invalid diary data");
		}
		try {
			diary.setCreatedAt(Instant.now());
			diaryRepository.save(diary);
			return ResponseEntity.status(HttpStatus.CREATED).body("Diary saved successfully");
		} catch (Exception e) {
			e.printStackTrace();
			return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR).body("Error saving diary");
		}
	}
	
	// 일기 불러오기
	@GetMapping("/getDiary")
	public ResponseEntity<List<DiaryDocument>> getDiary(@RequestParam(required = false) String userId) {
		try {
			List<DiaryDocument> diaries;
			if (userId != null) {
				diaries = diaryRepository.findByUserId(userId);
			} else {
				diaries = diaryRepository.findAllActive();
			}
			
			if (diaries.isEmpty()) {
				return ResponseEntity.status(HttpStatus.NOT_FOUND).body(diaries);
			}
			return ResponseEntity.ok(diaries);
		} catch (Exception e) {
			return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR).body(null);
		}
	}
	
	// 일기 수정
	@PatchMapping("/updateDiary")
	public ResponseEntity<String> updateDiary(@RequestParam String id, @RequestBody DiaryDocument updatedDiary) {
		try {
			Optional<DiaryDocument> existingDiaryOptional = diaryRepository.findById(id);
			if (existingDiaryOptional.isEmpty()) {
				return ResponseEntity.status(HttpStatus.NOT_FOUND).body("Diary not found");
			}
			
			DiaryDocument existingDiary = existingDiaryOptional.get();
			
			// 업데이트할 필드 적용 (userId와 createdAt은 변경하지 않음)
			existingDiary.setTitle(updatedDiary.getTitle());
			existingDiary.setPieceIds(updatedDiary.getPieceIds());
			existingDiary.setThemeColor(updatedDiary.getThemeColor());
			existingDiary.setShared(updatedDiary.isShared());
			existingDiary.setEncryptionKeyId(updatedDiary.getEncryptionKeyId());
			existingDiary.setEmotion(updatedDiary.getEmotion());
			
			diaryRepository.save(existingDiary);
			return ResponseEntity.ok("Diary updated successfully");
		} catch (Exception e) {
			return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR).body("Error updating diary");
		}
	}
	
	// 일기 삭제 (isDeleted를 true로 설정)
	@PatchMapping("/deleteDiary")
	public ResponseEntity<String> deleteDiary(@RequestParam String id) {
		try {
			Optional<DiaryDocument> existingDiaryOptional = diaryRepository.findById(id);
			if (existingDiaryOptional.isEmpty()) {
				return ResponseEntity.status(HttpStatus.NOT_FOUND).body("Diary not found");
			}
			
			DiaryDocument existingDiary = existingDiaryOptional.get();
			
			// isDeleted를 true로 설정하여 논리적 삭제
			existingDiary.setDeleted(true);
			
			diaryRepository.save(existingDiary);
			return ResponseEntity.ok("Diary deleted successfully");
		} catch (Exception e) {
			return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR).body("Error deleting diary");
		}
	}
}

