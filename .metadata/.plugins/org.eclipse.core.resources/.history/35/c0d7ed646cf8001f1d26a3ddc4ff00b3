package com.puzzlelog.challenge.command;

import java.time.LocalDateTime;

import com.puzzlelog.challenge.controller.Command;
import com.puzzlelog.challenge.model.PointDocument;
import com.puzzlelog.challenge.repository.PointRepository;

// 사용자에게 포인트 지급 Command
public class AddUserPointCommand implements Command<Void> {
    private final PointRepository pointRepository;
    private final String userId;
    private final int amount;
    private final String challengeId;

    public AddUserPointCommand(PointRepository pointRepository, String userId, int amount, String challengeId) {
        this.pointRepository = pointRepository;
        this.userId = userId;
        this.amount = amount;
        this.challengeId = challengeId;
    }

    @Override
    public Void execute() {
        PointDocument point = new PointDocument(userId, "challenge", amount, "챌린지 보상 지급", challengeId);
        point.setCreatedAt(LocalDateTime.now());
        pointRepository.save(point);
        return null;
    }
}
