package com.puzzlelog.api.repository.old;

import java.util.List;
import java.util.Optional;

import org.springframework.data.mongodb.repository.MongoRepository;

import com.puzzlelog.api.document.old.PointDocument;

public interface PointRepository extends MongoRepository<PointDocument, String> {
    
	// 특정 사용자의 포인트 내역 조회
	List<PointDocument> findByUserId(String userId);
	
	
	 // ✅ 특정 사용자와 챌린지 ID로 포인트 지급 여부 확인 (중복 지급 방지)
	 Optional<PointDocument> findByUserIdAndRelatedChallengeId(String userId, String relatedChallengeId);
}

