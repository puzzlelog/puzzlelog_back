package com.puzzlelog.api.document.old;

import java.time.LocalDateTime;

import org.springframework.data.annotation.Id;
import org.springframework.data.mongodb.core.mapping.Document;

import com.fasterxml.jackson.annotation.JsonFormat;

import lombok.Getter;
import lombok.NoArgsConstructor;
import lombok.Setter;

@Document(collection = "notifications") // MongoDB 컬렉션명 설정
@Getter
@Setter
@NoArgsConstructor
public class NotificationDocument {
	@Id
    private String id; // MongoDB의 ObjectId

    private String message; // 알람 내용
    
    @JsonFormat(shape = JsonFormat.Shape.STRING, pattern = "yyyy-MM-dd'T'HH:mm:ss")
    private LocalDateTime sendTime;


    private boolean sent = false; // 발송 여부 (기본값: false)

	public String getMessage() {
		return this.message;
	}

	public void setSent(boolean b) {	
		this.sent = sent;
		
	}

   
}

