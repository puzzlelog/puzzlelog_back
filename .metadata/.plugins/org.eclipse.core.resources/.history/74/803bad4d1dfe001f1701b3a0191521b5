package com.puzzlelog.puzzlelog.repository;

import java.util.List;

import org.bson.types.ObjectId;
import org.springframework.data.mongodb.repository.MongoRepository;
import org.springframework.data.mongodb.repository.Query;

import com.puzzlelog.api.document.old.PieceDocument;

public interface PieceRepository extends MongoRepository<PieceDocument, String> {
	
	@Query("{'user_id': ?0, 'is_deleted': false}")
	List<PieceDocument> findByUserId(String userId); // 특정 사용자의 조각 조회
	
	@Query("{'is_deleted': false}")
	List<PieceDocument> findAllActive();
	
	List<PieceDocument> findByDiaryId(String diaryId);  // ✅ DiaryId 기준으로 piece 조회
}
