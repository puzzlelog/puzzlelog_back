package com.puzzlelog.api.repository.mysql;

import java.time.LocalDate;
import java.time.LocalDateTime;
import java.util.Optional;

import org.springframework.data.domain.Page;
import org.springframework.data.domain.Pageable;
import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.data.jpa.repository.Query;
import org.springframework.data.repository.query.Param;

import com.puzzlelog.api.dao.entity.User;

public interface UserRepository extends JpaRepository<User, Integer> {
    
    Optional<User> findByUserId(String userId);
    Optional<User> findByEmail(String email);
    Optional<User> findByNickname(String nickname);
    
    // 로그인 및 중복체크 시 사용
    boolean existsByUserId(String userId);
    boolean existsByEmail(String email);
    
    // 조회 사용
    @Query("SELECT u FROM User u WHERE "
            + "(:email IS NULL OR u.email = :email) AND "
            + "(:userId IS NULL OR u.userId = :userId) AND "
            + "(:nickname IS NULL OR u.nickname = :nickname) AND "
            + "(:createdAtFrom IS NULL OR u.createdAt >= :createdAtFrom) AND "
            + "(:createdAtTo IS NULL OR u.createdAt <= :createdAtTo) AND "
            + "(:birthDateFrom IS NULL OR u.birthDate >= :birthDateFrom) AND "
            + "(:birthDateTo IS NULL OR u.birthDate <= :birthDateTo) AND "
            + "(:gender IS NULL OR u.gender = :gender) AND "
            + "(:isAlarm IS NULL OR u.isAlarm = :isAlarm) AND "
            + "(:status IS NULL OR u.status = :status) AND "
            + "(:role IS NULL OR u.role = :role) AND "
            + "(:lastLoginFrom IS NULL OR u.lastLogin >= :lastLoginFrom) AND "
            + "(:lastLoginTo IS NULL OR u.lastLogin <= :lastLoginTo)")
    Page<User> findUsersByConditions(
            @Param("email") String email,
            @Param("userId") String userId,
            @Param("nickname") String nickname,
            @Param("createdAtFrom") LocalDateTime createdAtFrom,
            @Param("createdAtTo") LocalDateTime createdAtTo,
            @Param("birthDateFrom") LocalDate birthDateFrom,
            @Param("birthDateTo") LocalDate birthDateTo,
            @Param("gender") User.Gender gender,
            @Param("isAlarm") Boolean isAlarm,
            @Param("status") User.Status status,
            @Param("role") User.Role role,
            @Param("lastLoginFrom") LocalDateTime lastLoginFrom,
            @Param("lastLoginTo") LocalDateTime lastLoginTo,
            Pageable pageable);
}