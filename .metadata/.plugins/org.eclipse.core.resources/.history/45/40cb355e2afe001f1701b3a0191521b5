package com.puzzlelog.api.repository.old;

import java.util.List;
import java.util.Optional;

import org.springframework.data.mongodb.repository.Aggregation;
import org.springframework.data.mongodb.repository.MongoRepository;

import com.puzzlelog.api.document.old.UserChallengeDocument;

public interface UserChallengeRepository extends MongoRepository<UserChallengeDocument, String> {
    List<UserChallengeDocument> findByUserId(String userId);
     
    List<UserChallengeDocument> findByUserIdAndIsCompleted(String userId, boolean isCompleted); // ✅ 진행 중인 챌린지 조회
    
    // 특정 사용자가 특정 챌린지를 가지고 있는지 조회
    Optional<UserChallengeDocument> findByUserIdAndChallengeId(String userId, String challengeId); // ✅ 특정 챌린지 조회

    void deleteByUserIdAndChallengeId(String userId, String challengeId);
    
    
   

    // ✅ 전체 사용자 ID 리스트 가져오기 (중복 없이)
    @Aggregation("{ '$match': { 'userId': { '$ne': null } } }, { '$group': { '_id': '$userId' } }")
    List<String> findDistinctUserIds();

    
    

}
