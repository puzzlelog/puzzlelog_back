package com.puzzlelog.puzzlelog.command;

import com.puzzlelog.puzzlelog.controller.Command;
import com.puzzlelog.puzzlelog.model.ChallengeDocument;
import com.puzzlelog.puzzlelog.repository.ChallengeRepository;

// 관리자가 새로운 챌린지를 생성
public class CreateChallengeCommand implements Command<ChallengeDocument> {
    private final ChallengeRepository challengeRepository;
    private final ChallengeDocument challenge;

    public CreateChallengeCommand(ChallengeRepository challengeRepository, ChallengeDocument challenge) {
        this.challengeRepository = challengeRepository;
        this.challenge = challenge;
    }

    @Override
    public ChallengeDocument execute() {
        return challengeRepository.save(challenge);
    }
}

