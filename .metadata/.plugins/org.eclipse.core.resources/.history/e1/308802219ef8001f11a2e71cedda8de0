package com.puzzlelog.puzzlelog.repository;

import org.springframework.data.jpa.repository.JpaRepository;
import java.util.Optional;
import java.util.List;
import com.puzzlelog.puzzlelog.entity.Friend;
import com.puzzlelog.puzzlelog.entity.FriendStatus;

public interface FriendRepository extends JpaRepository<Friend, Integer> {
    Optional<Friend> findByUserIdAndFriendId(String userId, String friendId);
    List<Friend> findByUserIdAndStatus(String userId, FriendStatus status);
}
