package com.puzzlelog.puzzlelog.service;

import java.util.List;
import java.util.Optional;

import org.springframework.http.ResponseEntity;
import org.springframework.stereotype.Service;

import com.puzzlelog.puzzlelog.entity.Friend;
import com.puzzlelog.puzzlelog.entity.FriendStatus;
import com.puzzlelog.puzzlelog.repository.FriendRepository;
import com.puzzlelog.puzzlelog.repository.UserRepository;

import lombok.RequiredArgsConstructor;

@Service
public class FriendService {
    private final FriendRepository friendRepository;
    private final UserRepository userRepository;

    // ✅ 생성자를 명시적으로 추가
    public FriendService(FriendRepository friendRepository, UserRepository userRepository) {
        this.friendRepository = friendRepository;
        this.userRepository = userRepository;
    }

    // 친구 요청 보내기
    public ResponseEntity<String> sendFriendRequest(String userId, String friendId) {
        if (!userRepository.existsByUserId(userId) || !userRepository.existsByUserId(friendId)) {
            return ResponseEntity.badRequest().body("존재하지 않는 사용자입니다.");
        }

        // 중복 체크
        if (friendRepository.findByUserIdAndFriendId(userId, friendId).isPresent() ||
            friendRepository.findByUserIdAndFriendId(friendId, userId).isPresent()) {
            return ResponseEntity.badRequest().body("이미 친구 요청 또는 관계가 존재합니다.");
        }

        // 친구 요청 생성
        Friend friendRequest = new Friend(userId, friendId, FriendStatus.PENDING);
        friendRepository.save(friendRequest);
        return ResponseEntity.ok("친구 요청이 성공적으로 전송되었습니다.");
    }

    // 친구 요청 수락
    public ResponseEntity<String> acceptFriendRequest(String userId, String friendId) {
        Optional<Friend> friendOpt = friendRepository.findByUserIdAndFriendId(friendId, userId);
        if (friendOpt.isEmpty()) {
            return ResponseEntity.badRequest().body("친구 요청이 없습니다.");
        }

        Friend friend = friendOpt.get();
        friend.setStatus(FriendStatus.ACCEPTED);
        friendRepository.save(friend);

        // 상대방도 친구 목록에 추가
        friendRepository.save(new Friend(userId, friendId, FriendStatus.ACCEPTED));

        return ResponseEntity.ok("친구 요청을 수락했습니다.");
    }

    // 친구 목록 불러오기
    public List<Friend> getFriends(String userId) {
        return friendRepository.findByUserIdAndStatus(userId, FriendStatus.ACCEPTED);
    }

    // 친구 삭제
    public ResponseEntity<String> deactivateFriend(String userId, String friendId) {
        Optional<Friend> friendOpt1 = friendRepository.findByUserIdAndFriendId(userId, friendId);
        Optional<Friend> friendOpt2 = friendRepository.findByUserIdAndFriendId(friendId, userId);

        if (friendOpt1.isPresent()) {
            Friend friend = friendOpt1.get();
            friend.setStatus(FriendStatus.DEACTIVATED);
            friendRepository.save(friend);
        }

        if (friendOpt2.isPresent()) {
            Friend friend = friendOpt2.get();
            friend.setStatus(FriendStatus.DEACTIVATED);
            friendRepository.save(friend);
        }

        if (friendOpt1.isPresent() || friendOpt2.isPresent()) {
            return ResponseEntity.ok("친구 관계가 비활성화되었습니다.");
        } else {
            return ResponseEntity.badRequest().body("해당 친구 관계를 찾을 수 없습니다.");
        }
    }
}
