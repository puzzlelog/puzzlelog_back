package com.puzzlelog.api.service.challenge.old;

import java.time.LocalDateTime;

import com.puzzlelog.api.config.old.Command;
import com.puzzlelog.api.document.old.PointDocument;
import com.puzzlelog.api.repository.old.OldPointRepository;

//사용자에게 포인트 지급 Command
public class AddUserPointService implements Command<Void> {
 private final OldPointRepository pointRepository;
 private final String userId;
 private final int amount;
 private final String challengeId;

 public AddUserPointService(OldPointRepository pointRepository, String userId, int amount, String challengeId) {
     this.pointRepository = pointRepository;
     this.userId = userId;
     this.amount = amount;
     this.challengeId = challengeId;
 }

 @Override
 public Void execute() {
     PointDocument point = new PointDocument(userId, "challenge", amount, "챌린지 보상 지급", challengeId);
     point.setCreatedAt(LocalDateTime.now());
     pointRepository.save(point);
     return null;
 }
}
