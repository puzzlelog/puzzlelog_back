package com.puzzlelog.challenge.command;

import com.puzzlelog.challenge.controller.Command;
import com.puzzlelog.challenge.repository.UserChallengeRepository;

// ✅ 사용자가 챌린지를 취소할 때 호출하는 Command
public class CancelUserChallengeCommand implements Command<Void> {
    private final UserChallengeRepository userChallengeRepository;
    private final String userId;
    private final String challengeId;

    public CancelUserChallengeCommand(UserChallengeRepository userChallengeRepository, String userId, String challengeId) {
        this.userChallengeRepository = userChallengeRepository;
        this.userId = userId;
        this.challengeId = challengeId;
    }

    @Override
    public Void execute() {
        // ✅ 사용자의 해당 챌린지를 삭제
        userChallengeRepository.deleteByUserIdAndChallengeId(userId, challengeId);
        return null;
    }
}
