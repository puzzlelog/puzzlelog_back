package com.puzzlelog.puzzlelog.service.challenge;

import java.util.List;

import com.puzzlelog.puzzlelog.config.Command;
import com.puzzlelog.puzzlelog.document.ChallengeDocument;
import com.puzzlelog.puzzlelog.repository.ChallengeRepository;

//🔥 현재 활성화된 챌린지 조회 Command
public class GetActiveChallengesCommand implements Command<List<ChallengeDocument>> {
 private final ChallengeRepository challengeRepository;

 // 생성자를 통해 ChallengeRepository를 주입받음
 public GetActiveChallengesCommand(ChallengeRepository challengeRepository) {
     this.challengeRepository = challengeRepository;
 }

 @Override
 public List<ChallengeDocument> execute() {
     // 🔥 현재 활성화된 챌린지만 조회하여 반환
     return challengeRepository.findByIsActiveTrue();
     
//     challengeRepository.findByIsActiveTrue();를 호출하여 현재 활성화된 챌린지 목록을 가져옴.
//     활성화된 챌린지는 is_active 필드가 true인 챌린지를 의미함.
     
 }
}

