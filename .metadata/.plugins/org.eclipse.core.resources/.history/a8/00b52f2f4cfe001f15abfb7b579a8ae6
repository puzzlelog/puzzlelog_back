package com.puzzlelog.api.service;

import org.springframework.data.domain.Page;
import org.springframework.data.domain.PageRequest;
import org.springframework.data.domain.Pageable;
import org.springframework.data.domain.Sort;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import com.puzzlelog.api.dto.request.UserSearchRequest;
import com.puzzlelog.api.dto.response.UserResponse;
import com.puzzlelog.api.repository.mysql.UserRepository;

@Service
public class UserService {

    private final UserRepository userRepository;

    public UserService(UserRepository userRepository) {
        this.userRepository = userRepository;
    }

    // 전체 사용자 조회 (페이징)
    @Transactional(readOnly = true)
    public Page<UserResponse> getAllUsers(int page, int size) {
        return userRepository.findAll(PageRequest.of(page, size, Sort.by("createdAt").descending()))
                .map(UserResponse::from);
    }

    // 특정 사용자 정보 조회
    @Transactional(readOnly = true)
    public Page<UserResponse> findUsers(UserSearchRequest request, int page, int size) {
    	Pageable pageable = PageRequest.of(page, size, Sort.by("createdAt").descending());

        return userRepository.findUsersByConditions(
            request,
            request.getCreatedAtFrom() != null ? request.getCreatedAtFrom().atStartOfDay() : null,
            request.getCreatedAtTo() != null ? request.getCreatedAtTo().atTime(LocalTime.MAX) : null,
            request.getLastLoginFrom() != null ? request.getLastLoginFrom().atStartOfDay() : null,
            request.getLastLoginTo() != null ? request.getLastLoginTo().atTime(LocalTime.MAX) : null,
            pageable
        ).map(UserResponse::from);
    }
}
