package com.puzzlelog.puzzlelog.command;

import java.util.List;

import com.puzzlelog.puzzlelog.controller.Command;
import com.puzzlelog.puzzlelog.model.PointDocument;
import com.puzzlelog.puzzlelog.repository.PointRepository;

// 사용자의 포인트 조회 Command
public class GetUserPointsCommand implements Command<List<PointDocument>> {
    private final PointRepository pointRepository;
    private final String userId;

    public GetUserPointsCommand(PointRepository pointRepository, String userId) {
        this.pointRepository = pointRepository;
        this.userId = userId;
    }

    @Override
    public List<PointDocument> execute() {
        return pointRepository.findByUserId(userId);
    }
}

