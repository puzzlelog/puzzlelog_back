package com.puzzlelog.api.service.challenge.old;

import java.util.List;

import com.puzzlelog.api.config.old.Command;
import com.puzzlelog.api.document.old.UserChallengeDocument;
import com.puzzlelog.api.repository.old.OldUserChallengeRepository;

//✅ 사용자의 챌린지 진행 상태 조회 (완료 여부 포함)
public class FindUserChallengesService implements Command<List<UserChallengeDocument>> {
 private final OldUserChallengeRepository userChallengeRepository;
 private final String userId;
 private final boolean includeCompleted; // 완료된 챌린지도 조회할지 여부

 public FindUserChallengesService(OldUserChallengeRepository userChallengeRepository, String userId, boolean includeCompleted) {
     this.userChallengeRepository = userChallengeRepository;
     this.userId = userId;
     this.includeCompleted = includeCompleted;
 }

 @Override
 public List<UserChallengeDocument> execute() {
     if (includeCompleted) {
         return userChallengeRepository.findByUserId(userId);
     } else {
         return userChallengeRepository.findByUserIdAndIsCompleted(userId, false); // 진행 중인 챌린지만 조회
     }
 }
}
