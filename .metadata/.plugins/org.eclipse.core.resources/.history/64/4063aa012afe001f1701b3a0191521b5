package com.puzzlelog.api.controller.old;



import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.HttpHeaders;
import org.springframework.http.MediaType;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import com.puzzlelog.api.document.old.AlbumDocument;
import com.puzzlelog.api.service.old.AlbumService;

@RestController("oldUserController")
@RequestMapping("/api/albums")
public class AlbumController {
	
	@Autowired
    private AlbumService albumService;
	

    
    

    // 사용자별 앨범 목록 조회
    @GetMapping("/{userId}")
    public ResponseEntity<List<AlbumDocument>> getUserAlbums(@PathVariable (value = "userId") String userId) {
    	
    	System.out.println("userId: "+userId);
        return ResponseEntity.ok(albumService.getAlbumsByUser(userId));
    }

    // 특정 앨범 상세 조회
    @GetMapping("/{albumId}/{userId}")
    public ResponseEntity<AlbumDocument> getAlbumById(@PathVariable ( value = "albumId") String albumId, @PathVariable (value = "userId") String userId) {
        return ResponseEntity.ok(albumService.getAlbumById(albumId, userId));
    }

    
	// ✅ 앨범 결제 완료 처리
	@PostMapping("/{albumId}/{userId}/purchase")
	public ResponseEntity<String> purchaseAlbum(@PathVariable("albumId") String albumId,@PathVariable("userId") String userId) {
		albumService.purchaseAlbum(albumId, userId);
		return ResponseEntity.ok("결제가 완료되었습니다.");
	}
    
    
	


}

