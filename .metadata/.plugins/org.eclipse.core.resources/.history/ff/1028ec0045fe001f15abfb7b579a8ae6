package com.puzzlelog.api.service;

import com.puzzlelog.api.dao.entity.User;
import com.puzzlelog.api.dto.request.UserSearchRequest;
import com.puzzlelog.api.dto.response.UserResponse;
import com.puzzlelog.api.repository.mysql.UserRepository;
import org.springframework.data.domain.Page;
import org.springframework.data.domain.PageRequest;
import org.springframework.data.domain.Sort;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import java.util.Optional;

@Service
public class UserService {

    private final UserRepository userRepository;

    public UserService(UserRepository userRepository) {
        this.userRepository = userRepository;
    }

    // 전체 사용자 조회 (페이징)
    @Transactional(readOnly = true)
    public Page<UserResponse> getAllUsers(int page, int size) {
        return userRepository.findAll(PageRequest.of(page, size, Sort.by("createdAt").descending()))
                .map(UserResponse::from);
    }

    // 특정 사용자 정보 조회
    @Transactional(readOnly = true)
    public UserResponse findUser(UserSearchRequest request) {
        Optional<User> userOptional = Optional.empty();

        if (request.getEmail() != null) {
            userOptional = userRepository.findByEmail(request.getEmail());
        } else if (request.getUserId() != null) {
            userOptional = userRepository.findByUserId(request.getUserId());
        } else if (request.getNickname() != null) {
            userOptional = userRepository.findByNickname(request.getNickname());
        }

        return userOptional.map(UserResponse::from).orElse(null);
    }
}
