package com.puzzlelog.puzzlelog.service.challenge;

import com.puzzlelog.api.config.old.Command;
import com.puzzlelog.api.document.old.ChallengeDocument;
import com.puzzlelog.api.repository.old.ChallengeRepository;

//관리자가 새로운 챌린지를 생성
public class CreateChallengeService implements Command<ChallengeDocument> {
    private final ChallengeRepository challengeRepository;
    private final ChallengeDocument challenge;

    public CreateChallengeService(ChallengeRepository challengeRepository, ChallengeDocument challenge) {
        this.challengeRepository = challengeRepository;
        this.challenge = challenge;
    }

    @Override
    public ChallengeDocument execute() {
        return challengeRepository.save(challenge);
    }
}

