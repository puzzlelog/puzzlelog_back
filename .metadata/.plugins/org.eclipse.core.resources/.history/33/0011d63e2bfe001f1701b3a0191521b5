package com.puzzlelog.api;

import org.springframework.boot.SpringApplication;
import org.springframework.boot.autoconfigure.SpringBootApplication;
import org.springframework.boot.autoconfigure.domain.EntityScan;
import org.springframework.data.jpa.repository.config.EnableJpaRepositories;

@SpringBootApplication(scanBasePackages = {
	    "com.puzzlelog.api.controller",
	    "com.puzzlelog.api.dao.entity",
	    "com.puzzlelog.api.repository.mysql",
	    "com.puzzlelog.api.service",
	    "com.puzzlelog.api.config"
	})
	@EnableJpaRepositories(basePackages = "com.puzzlelog.api.repository.mysql")
	@EntityScan(basePackages = "com.puzzlelog.api.dao.entity")
public class PuzzlelogApplication {

	public static void main(String[] args) {
		SpringApplication.run(PuzzlelogApplication.class, args);
	}

}
