package com.bit.puzzlelog.dto;

import java.time.Instant;
import java.util.List;

import org.springframework.data.annotation.Id;
import org.springframework.data.mongodb.core.mapping.Document;
import org.springframework.data.mongodb.core.mapping.Field;

@Document(collection = "time_capsules")
public class TimeCapsuleDto {

	@Id
	private String id;
	@Field("user_id")
	private String userId;
	private String title;
	private String message;
	@Field("open_date")
	private Instant openDate; // 개봉 예정일
	@Field("media_id")
	private String mediaId; // 연결된 미디어 파일
	@Field("is_shared")
	private boolean isShared; // 공유 여부
	@Field("shared_with")
	private List<String> sharedWith;
	private String status; // ["Locked", "opened"]
	@Field("created_at")
	private Instant createdAt;
	@Field("is_deleted")
	private boolean isDeleted = false; // 기본값 false

	public TimeCapsuleDto() {
	}

	public TimeCapsuleDto(String userId, String title, String message, Instant openDate, String mediaId,
			boolean isShared, List<String> sharedWith, String status, Instant createdAt, boolean isDeleted) {
		this.userId = userId;
		this.title = title;
		this.message = message;
		this.openDate = openDate;
		this.mediaId = mediaId;
		this.isShared = isShared;
		this.sharedWith = sharedWith;
		this.status = status;
		this.createdAt = createdAt;
		this.isDeleted = isDeleted;
	}

	// Getter & Setter
	public String getId() {
		return id;
	}

	public void setId(String id) {
		this.id = id;
	}

	public String getUserId() {
		return userId;
	}

	public void setUserId(String userId) {
		this.userId = userId;
	}

	public String getTitle() {
		return title;
	}

	public void setTitle(String title) {
		this.title = title;
	}

	public String getMessage() {
		return message;
	}

	public void setMessage(String message) {
		this.message = message;
	}

	public Instant getOpenDate() {
		return openDate;
	}

	public void setOpenDate(Instant openDate) {
		this.openDate = openDate;
	}

	public String getMediaId() {
		return mediaId;
	}

	public void setMediaId(String mediaId) {
		this.mediaId = mediaId;
	}

	public boolean isShared() {
		return isShared;
	}

	public void setShared(boolean shared) {
		isShared = shared;
	}

	public List<String> getSharedWith() {
		return sharedWith;
	}

	public void setSharedWith(List<String> sharedWith) {
		this.sharedWith = sharedWith;
	}

	public String getStatus() {
		return status;
	}

	public void setStatus(String status) {
		this.status = status;
	}

	public Instant getCreatedAt() {
		return createdAt;
	}

	public void setCreatedAt(Instant createdAt) {
		this.createdAt = createdAt;
	}

	public boolean isDeleted() {
		return isDeleted;
	}

	public void setDeleted(boolean isDeleted) {
		this.isDeleted = isDeleted;
	}
}
