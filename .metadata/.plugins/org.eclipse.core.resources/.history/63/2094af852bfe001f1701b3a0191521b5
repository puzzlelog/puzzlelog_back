package com.puzzlelog.api.service.challenge.old;

import com.puzzlelog.api.config.old.Command;
import com.puzzlelog.api.repository.old.OldUserChallengeRepository;

//✅ 사용자가 챌린지를 취소할 때 호출하는 Command
public class CancelUserChallengeService implements Command<Void> {
 private final OldUserChallengeRepository userChallengeRepository;
 private final String userId;
 private final String challengeId;

 public CancelUserChallengeService(OldUserChallengeRepository userChallengeRepository, String userId, String challengeId) {
     this.userChallengeRepository = userChallengeRepository;
     this.userId = userId;
     this.challengeId = challengeId;
 }

 @Override
 public Void execute() {
     // ✅ 사용자의 해당 챌린지를 삭제
     userChallengeRepository.deleteByUserIdAndChallengeId(userId, challengeId);
     return null;
 }
}
